# Every checkout is LF, whatever the developer's core.autocrlf setting.
# gofmt and golangci-lint both demand LF in the working tree, and a CRLF
# checkout fails their checks on Windows while the committed bytes are
# perfectly formatted. Git auto-detects the binary assets and leaves them
# alone under text=auto.
* text=auto eol=lf

# These files have Windows-specific runtimes that behave better with CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf